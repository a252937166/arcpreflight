[Unit]
Description=ArcPreflight API (restricted profile)
After=network.target

[Service]
Type=simple
EnvironmentFile=/opt/arcpreflight/arcpreflight.env
ExecStart=/usr/local/bin/node /opt/arcpreflight/dist/server.mjs
Restart=always
RestartSec=3
WorkingDirectory=/opt/arcpreflight
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arcpreflight
MemoryLimit=200M

[Install]
WantedBy=multi-user.target
