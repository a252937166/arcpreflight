[Unit]
Description=ArcPreflight API — testnet instance (restricted profile), served under /testnet
After=network.target

[Service]
Type=simple
EnvironmentFile=/opt/arcpreflight/arcpreflight-testnet.env
ExecStart=/usr/local/bin/node /opt/arcpreflight/dist/server.mjs
Restart=always
RestartSec=3
WorkingDirectory=/opt/arcpreflight
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arcpreflight-testnet
MemoryLimit=200M

[Install]
WantedBy=multi-user.target
